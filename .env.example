# Copy to .env and replace placeholders before running docker compose up -d
POSTGRES_USER=pulse_app
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_PASSWORD
POSTGRES_DB=pulse_db
POSTGRES_PORT=5433

DATABASE_URL=postgres://pulse_app:CHANGE_ME_LOCAL_PASSWORD@localhost:5432/pulse_db?sslmode=disable
REDIS_ADDR=localhost:6379